<Window x:Class="IssueBuddy.PDFSplitter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IssueBuddy"
        mc:Ignorable="d"
        Title="PDF Splitter"
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        FontWeight="Light"
        FontSize="12"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Icon="/IssueBuddy;component/img/pdfsplitter16.png">

    <Window.Resources>
        <!-- ── Colour palette ── -->
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#B21616"/>
        <SolidColorBrush x:Key="LightPinkBrush"     Color="#FFF0F2"/>
        <SolidColorBrush x:Key="BorderPinkBrush"    Color="#FFD0D6"/>
        <SolidColorBrush x:Key="TextDarkBrush"      Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DCDCDC"/>
        <SolidColorBrush x:Key="SubtleBrush"        Color="#555555"/>
        <SolidColorBrush x:Key="FaintBrush"         Color="#FAFAFA"/>
        <SolidColorBrush x:Key="ReadOnlyBrush"      Color="#F3F3F3"/>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="BorderBrush"              Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="{StaticResource FaintBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                    <Setter Property="Background"  Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ReadOnlyBrush}"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBlock (read-only path display) -->
        <Style x:Key="PathDisplayStyle" TargetType="TextBlock">
            <Setter Property="Background"           Value="{StaticResource ReadOnlyBrush}"/>
            <Setter Property="Foreground"           Value="#888888"/>
            <Setter Property="Padding"              Value="6,4"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
            <Setter Property="TextTrimming"         Value="CharacterEllipsis"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{StaticResource FaintBrush}"/>
            <Setter Property="Height"          Value="27"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"        Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,3"/>
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground"        Value="{StaticResource SubtleBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="0,0,0,0"/>
        </Style>

        <!-- GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,8,12,12"/>
            <Setter Property="Margin"          Value="0,0,0,0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView -->
        <Style TargetType="ListView">
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{StaticResource FaintBrush}"/>
        </Style>

        <!-- GridViewColumnHeader -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"                 Value="#F3F3F3"/>
            <Setter Property="Foreground"                 Value="{StaticResource SubtleBrush}"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Padding"                    Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness"            Value="0,0,0,1"/>
            <Setter Property="BorderBrush"                Value="{StaticResource ControlBorderBrush}"/>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="15,6"/>
            <Setter Property="MinWidth"        Value="85"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background"      Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#911212"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon button (small: ..., →, ↑, ↓, Ꭓ) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="27"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Title            -->
            <RowDefinition Height="12"/>
            <!-- 1: Spacer           -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Input GroupBox   -->
            <RowDefinition Height="20"/>
            <!-- 3: Spacer           -->
            <RowDefinition Height="*"/>
            <!-- 4: Template GroupBox-->
            <RowDefinition Height="12"/>
            <!-- 5: Spacer           -->
            <RowDefinition Height="36"/>
            <!-- 6: Status + buttons -->
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0"
                   Text="PDF Splitter"
                   Foreground="{StaticResource PrimaryAccentBrush}"
                   FontSize="20" FontWeight="Bold"/>



        <!-- ══════════════════════════════════════════════════════════════════
             INPUT GROUP
        ══════════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="2" Header="Input">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: PDF row          -->
                    <RowDefinition Height="8"/>
                    <!-- 1: Spacer           -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: DWG checkboxes   -->
                    <RowDefinition Height="8"/>
                    <!-- 3: Spacer           -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: DWG path row     -->
                    <RowDefinition Height="8"/>
                    <!-- 5: Spacer           -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6: Export settings  -->
                    <RowDefinition Height="8"/>
                    <!-- 7: Spacer           -->
                    <RowDefinition Height="Auto"/>
                    <!-- 8: Print set row    -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <!-- 0: Label        -->
                    <ColumnDefinition Width="50"/>
                    <!-- 1: Count        -->
                    <ColumnDefinition Width="*"/>
                    <!-- 2: Value / path -->
                    <ColumnDefinition Width="8"/>
                    <!-- 3: Gap          -->
                    <ColumnDefinition Width="32"/>
                    <!-- 4: Browse btn   -->
                    <ColumnDefinition Width="16"/>
                    <!-- 5: Gap          -->
                    <ColumnDefinition Width="140"/>
                    <!-- 6: Drop image   -->
                </Grid.ColumnDefinitions>

                <!-- PDF to Split -->
                <Label     Grid.Row="0" Grid.Column="0" Content="PDF to Split:"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="txt_PDFCount"
                           Style="{StaticResource PathDisplayStyle}"
                           Margin="0,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2"
                           x:Name="txt_PDFPath"
                           Style="{StaticResource PathDisplayStyle}"/>
                <Button    Grid.Row="0" Grid.Column="4"
                           x:Name="btn_getPDF"
                           Content="..."
                           Style="{StaticResource IconButtonStyle}"
                           Click="btn_getPDF_Click"/>

                <!-- DWG checkboxes -->
                <Label Grid.Row="2" Grid.Column="0" Content="DWGs:" VerticalAlignment="Top" Margin="0,3,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3">
                    <CheckBox x:Name="chx_GenerateDWGS"
                              Content="Export DWGs"
                              IsChecked="True"
                              Checked="chx_GenerateDWGS_Checked"
                              Unchecked="chx_GenerateDWGS_Checked"/>
                    <CheckBox x:Name="chx_GenerateDWGViews"
                              Content="Export a copy of plan views as separate DWGs (on Shared Coordinates)"
                              Margin="16,0,0,0"/>
                    <CheckBox x:Name="chx_NoXrefs"
                              Content="DON'T export views as Xrefs"
                              IsChecked="True"
                              Margin="16,0,0,0"/>
                    <CheckBox x:Name="chx_TrueColourExport"
                              Content="True Colour Exports"
                              IsChecked="True"
                              Margin="16,0,0,0"/>
                    <CheckBox x:Name="chx_DeletePcp"
                              Content="Delete PCP files"
                              IsChecked="True"
                              Margin="16,0,0,0"/>
                    <CheckBox x:Name="chx_SeparateFolders"
                              Content="Export PDFs and DWGs to separate sub-folders (\PDF and \DWG)"
                              IsChecked="False"
                              Margin="16,0,0,0"
                              ToolTip="Creates 'PDF' and 'DWG' sub-folders next to the source PDF (or under the chosen DWG path) and sorts outputs into them."/>
                </StackPanel>

                <!-- DWG Export Path -->
                <Label     Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="DWG Export Path:"  Foreground="{StaticResource SubtleBrush}"/>
                        <TextBlock Text="(Leave blank for same path)" Foreground="#AAAAAA" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Label>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           x:Name="txt_DWGCount"
                           Style="{StaticResource PathDisplayStyle}"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           x:Name="txt_DWGPath"
                           Style="{StaticResource PathDisplayStyle}"/>
                <Button    Grid.Row="4" Grid.Column="4"
                           x:Name="btn_getDWGs"
                           Content="..."
                           Style="{StaticResource IconButtonStyle}"
                           Click="btn_getDWG_Click"/>

                <!-- DWG Export Settings -->
                <Label   Grid.Row="6" Grid.Column="0" Content="DWG Export Settings:"/>
                <ComboBox Grid.Row="6" Grid.Column="2"
                          x:Name="cbb_ExportSettings"
                          ToolTip="Predefined DWG export setup from this project"/>

                <!-- Print Set -->
                <Label    Grid.Row="8" Grid.Column="0" Content="Print Set:"/>
                <TextBlock Grid.Row="8" Grid.Column="1"
                           x:Name="txt_PrintSetCount"
                           Style="{StaticResource PathDisplayStyle}"/>
                <ComboBox  Grid.Row="8" Grid.Column="2"
                           x:Name="cbb_PrintSet"
                           ToolTip="Sheet set whose order matches the pages in the PDF"
                           SelectionChanged="cbb_PrintSet_SelectionChanged"/>

                <!-- Drop zone spanning right column -->
                <Border Grid.Row="0" Grid.Column="6" Grid.RowSpan="9"
                        x:Name="brd_DropZone"
                        Width="132" Height="132"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{StaticResource FaintBrush}"
                        BorderBrush="{StaticResource ControlBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        AllowDrop="True"
                        Drop="img_PDF_Drop"
                        DragOver="brd_DropZone_DragOver"
                        DragLeave="brd_DropZone_DragLeave"
                        MouseLeftButtonUp="brd_DropZone_Click"
                        Cursor="Hand"
                        ToolTip="Drop a PDF binder here, or click to browse">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="PDF"
                                   x:Name="txt_DropIcon"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BorderPinkBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txt_DropHint"
                                   Text="Drop PDF here"
                                   Foreground="#888888"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="6,6,6,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- ══════════════════════════════════════════════════════════════════
             FILE NAME TEMPLATE GROUP
        ══════════════════════════════════════════════════════════════════════ -->
        <GroupBox Grid.Row="4" x:Name="grp_Settings" Header="File Name Template">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Preset row      -->
                    <RowDefinition Height="8"/>
                    <!-- 1: Spacer          -->
                    <RowDefinition Height="*"/>
                    <!-- 2: Params + result -->
                    <RowDefinition Height="8"/>
                    <!-- 3: Spacer          -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Separators row  -->
                    <RowDefinition Height="8"/>
                    <!-- 5: Spacer          -->
                    <RowDefinition Height="Auto"/>
                    <!-- 6: Sample row      -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <!-- 0: Label           -->
                    <ColumnDefinition Width="*"/>
                    <!-- 1: Left content    -->
                    <ColumnDefinition Width="8"/>
                    <!-- 2: Gap             -->
                    <ColumnDefinition Width="32"/>
                    <!-- 3: Arrow button    -->
                    <ColumnDefinition Width="8"/>
                    <!-- 4: Gap             -->
                    <ColumnDefinition Width="*"/>
                    <!-- 5: Right content   -->
                    <ColumnDefinition Width="8"/>
                    <!-- 6: Gap             -->
                    <ColumnDefinition Width="32"/>
                    <!-- 7: Del button      -->
                    <ColumnDefinition Width="4"/>
                    <!-- 8: Gap             -->
                    <ColumnDefinition Width="32"/>
                    <!-- 9: Up button       -->
                    <ColumnDefinition Width="4"/>
                    <!-- 10: Gap            -->
                    <ColumnDefinition Width="32"/>
                    <!-- 11: Down button    -->
                </Grid.ColumnDefinitions>

                <!-- Preset row -->
                <Label    Grid.Row="0" Grid.Column="0" Content="Preset:"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          x:Name="cbb_Templates"
                          IsEditable="True"
                          ToolTip="Pick a saved preset, or type a new name and press Save"
                          SelectionChanged="cbb_Templates_SelectionChanged"/>
                <Button   Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                          x:Name="btn_SaveTemplate"
                          Content="Save"
                          ToolTip="Save the current template under the name in the box"
                          Style="{StaticResource IconButtonStyle}"
                          Width="45" Padding="8,0" Margin="0,0,0,0" HorizontalAlignment="Left"
                          Click="btn_SaveTemplate_Click"/>
                <Button   Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3"
                          x:Name="btn_Delete"
                          Content="Delete"
                          ToolTip="Delete the selected preset"
                          Style="{StaticResource IconButtonStyle}"
                          Click="btn_Delete_Click" HorizontalAlignment="Left"  Width="45" Margin="50,0,0,0"/>

                <!-- Parameters list  |  arrow  |  Template result list -->
                <Label Grid.Row="2" Grid.Column="0"
                       Content="Parameters:"
                       VerticalAlignment="Top" Margin="0,4,0,0"/>

                <ListView x:Name="lib_Params"
                          Grid.Row="2" Grid.Column="1"
                          MouseDoubleClick="btn_AddParameter_Click">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Parameter Name" Width="160" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type"           Width="100" DisplayMemberBinding="{Binding TypeName}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button Grid.Row="2" Grid.Column="3"
                        x:Name="btn_AddParameter"
                        Content="→"
                        FontSize="14"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Center"
                        Click="btn_AddParameter_Click"/>

                <Label Grid.Row="2" Grid.Column="5"
                       Content="File Naming Template:"
                       VerticalAlignment="Top" Margin="0,4,0,0"
                       Grid.ColumnSpan="7"/>

                <ListView x:Name="lib_name"
                          Grid.Row="2" Grid.Column="5"
                          Grid.ColumnSpan="7"
                          Margin="0,24,0,0">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Parameter" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Separators row -->
                <Label    Grid.Row="4" Grid.Column="0" Content="Separators:"/>
                <ComboBox Grid.Row="4" Grid.Column="1"
                          x:Name="cbb_Separator"
                          IsEditable="True"
                          ToolTip="Pick or type a separator, then add it to the template"/>
                <Button   Grid.Row="4" Grid.Column="3"
                          x:Name="btn_AddSeparator"
                          Content="→"
                          FontSize="14"
                          Style="{StaticResource IconButtonStyle}"
                          Click="btn_AddSeparator_Click"/>

                <!-- Template item controls (delete / up / down) -->
                <Button Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="3"
                        x:Name="btn_ItemDel"
                        Content="Delete"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btn_ItemDel_Click"  HorizontalAlignment="Right"  Width="45" Margin="0,0,0,0" />
                <Button Grid.Row="4" Grid.Column="9"
                        x:Name="btn_ItemUp"
                        Content="↑"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btn_ItemUp_Click"/>
                <Button Grid.Row="4" Grid.Column="11"
                        x:Name="btn_ItemDown"
                        Content="↓"
                        Style="{StaticResource IconButtonStyle}"
                        Click="btn_ItemDown_Click"/>

                <!-- Sample row -->
                <Label Grid.Row="6" Grid.Column="0" Content="Sample:"/>
                <TextBlock x:Name="lbl_sample"
                           Grid.Row="6" Grid.Column="1"
                           Grid.ColumnSpan="11"
                           Foreground="{StaticResource SubtleBrush}"
                           VerticalAlignment="Center"
                           FontStyle="Italic"
                           Text="{}"/>
            </Grid>
        </GroupBox>

        <!-- ── Status bar + footer buttons ───────────────────────────────── -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="prg_Progress"
                         Grid.Column="0"
                         Height="10"
                         VerticalAlignment="Center"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="{StaticResource PrimaryAccentBrush}"
                         Background="{StaticResource ReadOnlyBrush}"
                         BorderThickness="0"/>

            <TextBlock x:Name="lbl_Status"
                       Grid.Column="2"
                       Text="Select a PDF and a Print Set to begin."
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontStyle="Italic"/>
                       
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="btn_Cancel"
                        Content="Close"
                        Style="{StaticResource ModernButtonStyle}"
                        Margin="0,0,12,0"
                        Click="Btn_Cancel_Click"/>
                <Button x:Name="btn_Split"
                        Content="Split"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btn_Split_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="copyWrite"
                   Grid.Row="3" Grid.Column="0"
                       Text="﻿PDF Splitter uses PDFsharp libraries: Copyright (c) 2001-2026 empira Software GmbH, Troisdorf (Cologne Area), Germany"
                       Foreground="#888888"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis"
                       FontStyle="Italic"></TextBlock>
    </Grid>

</Window>
