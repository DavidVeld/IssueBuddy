<Window x:Class="IssueBuddy.RevisionViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Revision History Viewer" Height="650" Width="1000"
        MinHeight="450" MinWidth="750"
        FontFamily="Segoe UI" FontWeight="Light" FontSize="12"
        Background="#FFFFFF" Icon="/IssueBuddy;component/img/revviewer16.png">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryAccentBrush"  Color="#B21616"/>
        <SolidColorBrush x:Key="LightPinkBrush"      Color="#FFF0F2"/>
        <SolidColorBrush x:Key="BorderPinkBrush"     Color="#FFD0D6"/>
        <SolidColorBrush x:Key="TextDarkBrush"       Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ControlBorderBrush"  Color="#DCDCDC"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="20,6"/>
            <Setter Property="MinWidth"        Value="90"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
        </Style>

        <Style x:Key="CleanCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CleanRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sheets Issues &amp; Revisions History"
                   Foreground="{StaticResource PrimaryAccentBrush}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid x:Name="dg_RevisionHistory"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  ClipboardCopyMode="IncludeHeader"
                  Background="#FFFFFF"
                  BorderBrush="{StaticResource ControlBorderBrush}"
                  BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EAEAEA"
                  ColumnHeaderStyle="{StaticResource CleanHeaderStyle}"
                  CellStyle="{StaticResource CleanCellStyle}"
                  RowStyle="{StaticResource CleanRowStyle}"
                  Margin="0,0,0,20">
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Export CSV"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,12,0"
                    Click="Button_Click_Export"/>
            <Button Content="Close"
                    Style="{StaticResource ModernButtonStyle}"
                    Click="Button_Click_Close"/>
        </StackPanel>
    </Grid>
</Window>