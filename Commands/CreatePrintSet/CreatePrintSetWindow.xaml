<Window x:Class="IssueBuddy.CreatePrintSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IssueBuddy"
        mc:Ignorable="d"
        Title="Create Print Set"
        Height="591" Width="490"
        MinHeight="591" MinWidth="450"
        FontFamily="Segoe UI"
        FontWeight="Light"
        FontSize="12"
        Background="#FFFFFF"
        Loaded="Window_Loaded" Icon="/IssueBuddy;component/img/revset16.png">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryAccentBrush"  Color="#B21616"/>
        <SolidColorBrush x:Key="LightPinkBrush"      Color="#FFF0F2"/>
        <SolidColorBrush x:Key="BorderPinkBrush"     Color="#FFD0D6"/>
        <SolidColorBrush x:Key="TextDarkBrush"       Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ControlBorderBrush"  Color="#DCDCDC"/>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="BorderBrush"   Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"    Value="#FAFAFA"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush"  Value="{StaticResource BorderPinkBrush}"/>
                    <Setter Property="Background"   Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Revision ListBox -->
        <Style x:Key="RevisionListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderBrush"      Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Background"       Value="#FAFAFA"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="Margin"  Value="0,1"/>
                        <!-- Suppress the default blue highlight so the checkbox is the only indicator -->
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridView column header -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background"               Value="#F3F3F3"/>
            <Setter Property="Foreground"               Value="#555555"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness"          Value="0,0,0,1"/>
            <Setter Property="BorderBrush"              Value="{StaticResource ControlBorderBrush}"/>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="15,6"/>
            <Setter Property="MinWidth"        Value="85"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary (OK) button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background"      Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#911212"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Title                  -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Revisions label        -->
            <RowDefinition Height="120"/>
            <!-- 2: Revisions ListBox      -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Sheets label + count   -->
            <RowDefinition Height="*"/>
            <!-- 4: Sheets ListView        -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Print set name         -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Date prefix checkbox   -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Footer buttons         -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Create Printset from Revision"
                   Foreground="{StaticResource PrimaryAccentBrush}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Revisions label -->
        <TextBlock Grid.Row="1"
                   Text="Select Revisions:"
                   Foreground="#555555" Margin="0,0,0,6"
                   FontSize="11" FontWeight="SemiBold"/>

        <!--
            REVISION CHECKBOX LIST
            ══════════════════════════════════════════════════════════════════════
            FIX: IsChecked binds to {Binding IsSelected, Mode=TwoWay}
            
            The old binding was:
                IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
            
            That bound to the ListBoxItem's own IsSelected (row highlight state),
            NOT to RevisionViewModel.IsSelected, so _revList was never updated
            and UpdateSheetList() always saw zero checked items.
            ══════════════════════════════════════════════════════════════════════
        -->
        <ListBox x:Name="lst_Revisions"
                 Grid.Row="2"
                 Style="{StaticResource RevisionListBoxStyle}"
                 SelectionMode="Multiple"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- ✅ FIXED binding: targets RevisionViewModel.IsSelected directly -->
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Content="{Binding RevisionName}"
                              Checked="CheckBox_Changed"
                              Unchecked="CheckBox_Changed"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Sheets header row: label left, live count right -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="Sheets in Revision Set(s):"
                       Foreground="#555555"
                       FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <!-- Improvement: live sheet count label -->
            <TextBlock x:Name="lbl_SheetCount"
                       Foreground="#888888"
                       FontSize="11"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Sheets ListView -->
        <ListView x:Name="liv_Sheets"
                  Grid.Row="4" Margin="0,0,0,20"
                  Background="#FFFFFF"
                  BorderBrush="{StaticResource ControlBorderBrush}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource LightPinkBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Sheet Number" Width="100" DisplayMemberBinding="{Binding Number}"/>
                    <GridViewColumn Header="Sheet Name"   Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Revision"     Width="80"  DisplayMemberBinding="{Binding Rev}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Print set name input -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Print set name:"
                       VerticalAlignment="Center" Width="100" Foreground="#555555"/>
            <TextBox Grid.Column="1" x:Name="txt_SheetSetName" VerticalAlignment="Center"/>
        </Grid>

        <!-- Date prefix checkbox -->
        <CheckBox Grid.Row="6"
                  x:Name="chx_DataYes"
                  Content="Use date as prefix to print set name"
                  Margin="0,0,0,24"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Checked="chx_DataYes_Checked"
                  Unchecked="chx_DataYes_Checked"/>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy List"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,12,0"
                    Click="Button_Click_Copy"/>
            <Button Content="Cancel"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,12,0"
                    Click="Button_Click"/>
            <Button Content="OK"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
