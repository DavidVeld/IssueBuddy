<Window x:Class="IssueBuddy.ModelStripperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IssueBuddy"
        mc:Ignorable="d"
        Title="Model Stripper"
        Height="550" Width="370"
        MinHeight="550" MinWidth="370"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontWeight="Light"
        FontSize="12"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Icon="/IssueBuddy;component/img/packmodel16.png">

    <Window.Resources>
        <!-- ── Colour palette (matches CreatePrintSetWindow) ── -->
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#B21616"/>
        <SolidColorBrush x:Key="LightPinkBrush"     Color="#FFF0F2"/>
        <SolidColorBrush x:Key="BorderPinkBrush"    Color="#FFD0D6"/>
        <SolidColorBrush x:Key="TextDarkBrush"      Color="#2C2C2C"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DCDCDC"/>
        <SolidColorBrush x:Key="SubtleBrush"        Color="#555555"/>
        <SolidColorBrush x:Key="FaintBrush"         Color="#FAFAFA"/>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="BorderBrush"      Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Background"       Value="{StaticResource FaintBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                    <Setter Property="Background"  Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="Background" Value="#F3F3F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"         Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Margin"             Value="0,4"/>
        </Style>

        <!-- RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"        Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,4"/>
        </Style>

        <!-- GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8,10,10"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource SubtleBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="15,6"/>
            <Setter Property="MinWidth"        Value="85"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource LightPinkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderPinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background"      Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#911212"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Title         -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Remove group  -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Save group    -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Keep worksets -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Save before   -->
            <RowDefinition Height="*"/>
            <!-- 5: Spacer        -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Buttons       -->
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0"
                   Text="Model Stripper"
                   Foreground="{StaticResource PrimaryAccentBrush}"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- ── Remove GroupBox ────────────────────────────────────────────── -->
        <GroupBox Grid.Row="1" Header="Export then Remove:">
            <StackPanel>
                <CheckBox x:Name="chk_StripViews"         Content="Views"                       IsChecked="True"/>
                <CheckBox x:Name="chk_StripSheets"        Content="Sheets"                      IsChecked="True"/>
                <CheckBox x:Name="chk_StripLegends"       Content="Legends"                     IsChecked="True"/>
                <!-- Off by default: stripping schedules also takes the revisions
                     with it, which is rarely what you want when issuing. -->
                <CheckBox x:Name="chk_StripSchedules"     Content="Schedules and revisions"     IsChecked="False"
                          ToolTip="Removes schedules from the stripped model. This also removes the revision history, so it is off by default."/>
                <CheckBox x:Name="chk_StripViewTemplates" Content="View Templates"              IsChecked="True"/>
                <CheckBox x:Name="chk_UnlinkRvt"          Content="Unload all Revit Links"      IsChecked="True"/>
                <CheckBox x:Name="chk_UngroupModels"      Content="Ungroup all model groups"    IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <!-- ── Save Settings GroupBox ─────────────────────────────────────── -->
        <GroupBox Grid.Row="2" Header="Default Filename:">
            <StackPanel>
                <TextBox x:Name="txt_FileName"
                         Height="28" Margin="0,6,0,2"
                         IsEnabled="False"
                         ToolTip="Enter a custom file name for the stripped model"/>
            </StackPanel>
        </GroupBox>

        <!-- ── Keep Worksets ──────────────────────────────────────────────── -->
        <CheckBox Grid.Row="3"
                  x:Name="chk_KeepWorkSets"
                  Content="Keep worksets  (new file will be a central)"
                  IsChecked="True"
                  Margin="0,0,0,8"/>

        <!-- ── Save Before Strip ──────────────────────────────────────────── -->
        <CheckBox Grid.Row="4"
                  x:Name="chb_SaveFile"
                  Content="Synchronise file before strip"
                  IsChecked="True"
                  Margin="0,0,0,0"/>

        <!-- ── Footer buttons ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btn_Cancel"
                    Content="Cancel"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,12,0"
                    Click="btn_Cancel_Click"/>
            <Button x:Name="btn_Export"
                    Content="Export"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="btn_Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
