<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-check for the PDF Splitter preset storage (FileNameTemplates.cs):
    legacy migration, import parsing/validation, shared folder reads.
    No Revit needed — the storage code touches no Revit types.
    How to run: see the top of Program.cs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\IssueBuddy.csproj" />
  </ItemGroup>

</Project>
